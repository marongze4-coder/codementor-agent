# Copy this file to .env.local and replace every CHANGE_ME value.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=CHANGE_ME

# Milvus (etcd and MinIO are internal Docker dependencies)
MILVUS_HOST=localhost
MILVUS_PORT=19531
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
ATTU_PORT=30000

# DeepSeek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# Local models bundled under backend/models
RERANKER_MODEL_PATH=models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=models/classifier/all-MiniLM-L6-v2
FINETUNED_CLASSIFIER_PATH=models/classifier/finetune
BGE_M3_MODEL_PATH=models/embedding/bge-m3

# Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal MCP endpoints
KB_MCP_SERVER_URL=http://localhost:8000/mcp/kb
WEB_SEARCH_MCP_URL=http://localhost:8000/mcp/web-search

# Optional web search key; empty falls back to DuckDuckGo
TAVILY_API_KEY=

# Code execution sandbox
PROJECT_NAME=CodeMentor Agent
MAX_CODE_UPLOAD_BYTES=524288
SANDBOX_ENABLED=true
SANDBOX_IMAGE=python:3.11-alpine
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5

# Application
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default
LLM_DAILY_LIMIT_PER_STUDENT=0
